# 复制为 .env 使用（.env 不进版本库）
# FlyEnv 的 PostgreSQL：超级用户是 root（initdb -U root），trust 免密，仅监听 127.0.0.1
DATABASE_URL=postgresql+psycopg://root@127.0.0.1:5432/workbench
SECRET_KEY=换成一段随机字符串
DEBUG=true

# 媒体上传（都有默认值，通常不用改）
# 注意 UPLOAD_ALLOWED_EXT 是列表，必须写 JSON 数组，不能写逗号分隔
# UPLOAD_DIR=D:\data\workData\liuhao_AI\workbench\backend\data\uploads
# UPLOAD_MAX_SIZE=209715200
# UPLOAD_ALLOWED_EXT=["jpg","png","mp3","mp4"]
